# Copy this file to .env and fill in your real key. Never commit .env itself.

# Get this from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_api_key_here

# Model name — swap to the exact Gemma 4 model id given at the hackathon
GEMMA_MODEL=gemma-4-it

AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here
PHONE_ENCRYPTION_KEY=your_fernet_key_here
PHONE_HASH_SALT=your_random_salt_here
ADMIN_ENCRYPTION_KEY=your_admin_fernet_key_here